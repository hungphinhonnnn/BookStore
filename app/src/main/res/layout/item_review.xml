<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgUserAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_launcher_background"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textStyle="bold"
                    android:textColor="#333"
                    android:textSize="14sp" />

                <RatingBar
                    android:id="@+id/ratingBar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:isIndicator="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/01/2023"
                android:textSize="11sp"
                android:textColor="#999" />
        </LinearLayout>

        <TextView
                android:id="@+id/tvMyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đánh giá của bạn"
                android:textSize="11sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

        <TextView
                android:id="@+id/tvReviewComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is a comment."
                android:textColor="#555"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.15" />

        <LinearLayout
            android:id="@+id/layoutMyReviewActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnEditReview"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Sửa"
                android:textSize="13sp"
                android:textColor="#2196F3"
                android:background="@drawable/bg_category_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btnDeleteReview"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Xóa"
                android:textSize="13sp"
                android:textColor="#F44336"
                android:background="@drawable/bg_category_chip" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
